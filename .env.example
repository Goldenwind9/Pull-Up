# Copy to .env and fill in. Real values go in the team's private note, never in Git.

# Public URL used for invite links
APP_URL=https://pull-up.tech

# Muse Spark (or fallback: any OpenAI-compatible API, e.g. Gemini)
AI_BASE_URL=https://api.meta.ai/v1
AI_API_KEY=
AI_MODEL=muse-spark-1.1

# Unused since the recap became a photo collage (lib/recap/images.ts is kept for later).
# Were: recap panel images, "muse", "gemini" or "none".
IMAGE_PROVIDER=muse
IMAGE_MODEL=muse-image-1.0
IMAGE_API_KEY=

# Places and events
SERPAPI_KEY=

# Tiger Cloud connection string
DATABASE_URL=

# Vultr Object Storage
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Long random string: openssl rand -base64 32
SESSION_SECRET=

# "true" replays cached AI/SerpApi answers if the network fails
DEMO_MODE=false

# Photo checker: "strict" (must match the quest and place), "lenient" (testing:
# any genuine photo loosely tied to the quest passes, location ignored), or
# "off" (every photo passes, AI only writes the caption). Restart after changing.
PROOF_CHECK=strict
